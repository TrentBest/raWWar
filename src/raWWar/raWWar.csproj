<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>TheSingularityWorkshop.raWWar</AssemblyName>
    <RootNamespace>TheSingularityWorkshop.raWWar</RootNamespace>
    <PackageId>TheSingularityWorkshop.Experiences.raWWar</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>raWWar — a persistent, first-person war Experience centered on individual soldiers and the people who command them.</Description>
    <PackageTags>singularity;workshop;experience;rawwar;fps;simulation;microbundle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TrentBest/raWWar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- These manifests live at the repository root, not beside this project file.
         Link them into the Experience output/package under their canonical names. -->
    <Content Include="../../manifest.json" Link="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/</PackagePath>
    </Content>
    <Content Include="../../runtime-manifest.json" Link="runtime-manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/</PackagePath>
    </Content>
  </ItemGroup>
</Project>
