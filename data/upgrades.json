    "researched",
    "design_released",
    "kit_manufactured",
    "quality_accepted",
    "stocked",
    "dispatched",
    "installation_authorized",
    "under_installation",
    "under_test",
    "accepted_and_fielded",
    "rejected_or_rework"
  ],
