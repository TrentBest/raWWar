{
  "schema": "raWWar.upgrade.v1",
  "deploymentRule": "Research unlocks a design; it does not install it. Each fielded upgrade requires a compatible target, manufactured kit, keyed stock, physical dispatch, qualified labor, downtime where required, acceptance testing and a persistent configuration record.",
  "upgradeLifecycle": [
    "researched",
    "design_released",
    "kit_manufactured",
    "quality_accepted",
    "stocked",
    "dispatched",
    "installation_authorized",
    "under_installation",
    "under_test",
    "accepted_and_fielded",
    "rejected_or_rework"
  ],
